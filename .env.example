PORT=3000
BARSIKCHAT_DOMAIN=chat.example.com
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://chatosnova:change-me@postgres:5432/chatosnova
APP_ORIGIN=https://chat.example.com
SESSION_DAYS=30
MAX_USERS=100
MAX_UPLOAD_MB=50
MAX_USER_STORAGE_MB=500
DATA_DIR=/app/data
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Development-only Barsik AI. Keep OPENAI_API_KEY on the server and never expose it as VITE_*.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=5
AI_REQUESTS_PER_MINUTE=8
AI_TIMEOUT_MS=45000
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=1200
